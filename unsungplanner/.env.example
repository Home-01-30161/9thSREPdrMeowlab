# Copy to .env.local and fill in. Never commit real keys.

# ── Core features ─────────────────────────────────────────────────────────────
TYPHOON_API_KEY=
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
SERPAPI_KEY=
TAVILY_API_KEY=
ORS_API_KEY=
AVIATIONSTACK_KEY=

# ── Neon Postgres: cache + quota + chat storage. Connection string is SERVER ONLY.
# Never prefix with NEXT_PUBLIC_. Get it from Connect in console.neon.tech.
NEON_DATABASE_URL=

# ── Limits (optional; defaults shown) ─────────────────────────────────────────
# Global plans per UTC day (all visitors combined).
DAILY_PLAN_LIMIT=100
# Plans per client IP per hour.
PLAN_PER_IP_LIMIT=5

# ── Bot protection (optional) ─────────────────────────────────────────────────
# Without these two values the app skips captcha entirely.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
